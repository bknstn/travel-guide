# Application
APP_BASE_URL=https://bot.example.com
APP_DOMAIN=bot.example.com
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username_here
TELEGRAM_WEBHOOK_SECRET=generate_a_long_random_secret
TRIBUTE_API_KEY=your_tribute_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MAPBOX_TOKEN=your_mapbox_token_here
SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Postgres
DATABASE_URL=postgresql://travel_guide:change_me@postgres:5432/travel_guide
POSTGRES_DB=travel_guide
POSTGRES_USER=travel_guide
POSTGRES_PASSWORD=change_me

# Storage and assets
GUIDES_ROOT=/data/guides
GUIDE_ASSETS_DIR=/srv/travel-guide/data/guides
BACKUP_OUTPUT_DIR=/srv/travel-guide/data/backups

# Caddy
CADDY_EMAIL=ops@example.com

# Restic + Backblaze B2
RESTIC_REPOSITORY=b2:your-bucket-name:travel-guide-backups
RESTIC_PASSWORD=change_me
B2_ACCOUNT_ID=your_b2_account_id
B2_ACCOUNT_KEY=your_b2_application_key
